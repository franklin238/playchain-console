# Public values only. Everything here ships in the website bundle.

# PlayChainArcade address and the block it was deployed in. Leave empty for preview mode.
VITE_ARCADE_ADDRESS=
VITE_DEPLOY_BLOCK=0

# Optional RPC tried before the public Robinhood Chain RPCs.
VITE_RPC_URL=

# The live site. Game URLs on this origin are served from the current deployment.
VITE_SITE_ORIGIN=https://playchain-console.vercel.app

# Extra origins games may be played from (comma separated).
VITE_PLAY_ORIGINS=

VITE_REPO_URL=
